# Leave unset to auto-select: ElevenLabs when a key exists, otherwise the offline mock.
# STT_PROVIDER=mock   # or elevenlabs

ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# OpenRouter (Gemini 3.5 Transcribe via /audio/transcriptions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=microsoft/mai-transcribe-2

# Local Qwen3-ASR + pyannote sidecar
QWEN_ASR_URL=http://127.0.0.1:8001
QWEN_ASR_TOKEN=
# Required by pyannote (accept the model terms on Hugging Face first)
HF_TOKEN=

# Optional adapters (not implemented in v1)
SONIOX_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
